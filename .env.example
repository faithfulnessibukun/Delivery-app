# Copy this file to `.env` and fill in the values from your Supabase dashboard
# (Project Settings -> API). `.env` is gitignored; this template is committed
# so anyone cloning the repo knows which variables are required.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
